+void DtlsTransport::handleTimeout() {
+	std::lock_guard lock(mSslMutex);
+	if (state() != State::Connecting)
+		return;
+
+	// Absolute monotonic lifetime, never extended by retries or incoming data.
+	const auto remaining = std::chrono::duration_cast<milliseconds>(
+	    120s - (std::chrono::steady_clock::now() - mHandshakeStarted));
+	if (remaining <= 0ms)
+		throw std::runtime_error("Handshake timeout");
+
+	// Warning: this function breaks the usual return value convention.
+	const int ret = DTLSv1_handle_timeout(mSsl);
+	if (ret < 0)
+		throw std::runtime_error("Handshake timeout");
+	if (ret > 0)
+		LOG_VERBOSE << "DTLS retransmit done";
+
+	// One pending wake only. The 4s cap also covers a passive peer with no
+	// OpenSSL flight timer yet, without adding a thread or an unbounded timer queue.
+	auto timeout = std::min(remaining, milliseconds(4000));
+	struct timeval tv = {};
+	if (DTLSv1_get_timeout(mSsl, &tv))
+		timeout = std::min(timeout, std::max(1ms, milliseconds(tv.tv_sec * 1000 + (tv.tv_usec + 999) / 1000)));
+
+	if (!mTimeoutPending.exchange(true)) {
+		ThreadPool::Instance().schedule(timeout, [weak_this = weak_from_this()]() {
+			if (auto locked = weak_this.lock()) {
+				locked->mTimeoutPending = false;
+				if (locked->state() == State::Connecting)
+					locked->enqueueRecv();
+			}
+		});
+	}
+}
 
