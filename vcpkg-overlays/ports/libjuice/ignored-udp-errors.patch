+    // Shared mux errors cannot be attributed to an individual agent.
+    if (agent->config.concurrency_mode != JUICE_CONCURRENCY_MODE_MUX)
+        agent_check_event(agent, NULL, JUICE_CHECK_UDP_ERROR_OBSERVATION_READY);
 
 	addr_record_t records[ICE_MAX_CANDIDATES_COUNT - 1];
 	int records_count = conn_get_addrs(agent, records, ICE_MAX_CANDIDATES_COUNT - 1);
@@ -711,6 +714,17 @@ int agent_conn_recv(juice_agent_t *agent, char *buf, size_t len, const addr_reco
 	return 0; // ignore errors
 }
 
+void agent_observe_udp_error(int error, void *user) {
+    juice_agent_t *agent = (juice_agent_t *)user;
+    if (agent->selected_pair) return; // no extra established-media hot-path work
+    if (error == SECONNRESET)
+        agent_check_event(agent, NULL, JUICE_CHECK_UDP_IGNORED_CONNRESET);
+    else if (error == SENETRESET)
+        agent_check_event(agent, NULL, JUICE_CHECK_UDP_IGNORED_NETRESET);
+    else if (error == SECONNREFUSED)
+        agent_check_event(agent, NULL, JUICE_CHECK_UDP_IGNORED_CONNREFUSED);
+}
+
 int agent_conn_fail(juice_agent_t *agent) {
 	agent_check_event(agent, NULL, JUICE_CHECK_SOCKET_IO_FAILED);
 	agent_change_state(agent, JUICE_STATE_FAILED);
