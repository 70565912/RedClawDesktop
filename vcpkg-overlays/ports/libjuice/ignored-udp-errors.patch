+++ b/src/udp.c
@@ -179,6 +179,12 @@ error:
 }
 
 int udp_recvfrom(socket_t sock, char *buffer, size_t size, addr_record_t *src) {
+    return udp_recvfrom_observed(sock, buffer, size, src, NULL, NULL);
+}
+
+int udp_recvfrom_observed(socket_t sock, char *buffer, size_t size, addr_record_t *src,
+                          udp_ignored_error_cb callback, void *user) {
+    unsigned ignored = 0;
 	while (true) {
 		src->len = sizeof(src->addr);
 		int len =
@@ -188,14 +194,25 @@ int udp_recvfrom(socket_t sock, char *buffer, size_t size, addr_record_t *src) {
 
 		} else if (sockerrno == SECONNRESET || sockerrno == SENETRESET ||
 		           sockerrno == SECONNREFUSED) {
+            const int ignored_error = sockerrno;
+            if (callback) callback(ignored_error, user);
 			// On Windows, if a UDP socket receives an ICMP port unreachable response after
 			// sending a datagram, this error is stored, and the next call to recvfrom() returns
 			// WSAECONNRESET (port unreachable) or WSAENETRESET (TTL expired).
 			// Therefore, it may be ignored.
 			JLOG_DEBUG("Ignoring %s returned by recvfrom",
-			           sockerrno == SECONNRESET
+			           ignored_error == SECONNRESET
 			               ? "ECONNRESET"
-			               : (sockerrno == SENETRESET ? "ENETRESET" : "ECONNREFUSED"));
+			               : (ignored_error == SENETRESET ? "ENETRESET" : "ECONNREFUSED"));
+            // Bound one receive turn even if asynchronous errors keep arriving.
+            if (++ignored == 64) {
+#ifdef _WIN32
+                WSASetLastError(SEWOULDBLOCK);
+#else
+                errno = SEWOULDBLOCK;
+#endif
+                return -1;
+            }
 			continue;
 		}
 		return len;
