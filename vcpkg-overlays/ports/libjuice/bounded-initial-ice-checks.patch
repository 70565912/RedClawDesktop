+			    agent->state == JUICE_STATE_CONNECTING && agent->config.initial_check_window_ms;
+			if (initial_check && !agent->initial_check_deadline)
+				agent->initial_check_deadline = now + agent->config.initial_check_window_ms;
+			const bool check_expired = initial_check && now >= agent->initial_check_deadline;
+			if (!check_expired && entry->next_transmission > now)
